# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Postgres via Supabase (Project Settings → Database)
# Prisma CLI reads `.env` (not `.env.local`). Copy these two lines into `.env` as well.
# URL-encode special characters in the password: + → %2B  & → %26  @ → %40
# Use the pooled URI for Prisma queries; direct URI for migrations.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local demo without Supabase. Do not set this on a publicly reachable host.
JR_ALLOW_DEMO=true

# Optional — Phase 6 AI Smart Nudge (falls back to local templates if empty)
OPENAI_API_KEY=

# Optional — required to delete the Auth user when someone uses Settings → Delete account.
# Also required for LINE Login (mints a session after the LINE callback).
SUPABASE_SERVICE_ROLE_KEY=

# Optional — PromptPay ID (phone or national ID) shown on /pricing checkout
NEXT_PUBLIC_PROMPTPAY_ID=

# Required to call POST /api/admin/billing/mark-paid (manual payment confirmation).
# There is no payment gateway webhook yet — after checking a PromptPay transfer slip, the
# operator calls that endpoint with this as a Bearer token to mark a checkout PAID, which is
# also what unlocks affiliate referral points. Generate with: openssl rand -hex 32
ADMIN_SECRET=

# LINE Official Account + Messaging API (never LINE Notify).
# Create a LINE Login channel and a Messaging API channel under the SAME provider,
# then link the OA to the Login channel. Scope used in-app: openid only.
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
LINE_LOGIN_CALLBACK_URL=http://localhost:3000/api/line/callback
LINE_MESSAGING_CHANNEL_SECRET=
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=
# Optional public OA basic ID for the “add friend” button, e.g. @mudmai
NEXT_PUBLIC_LINE_OA_BASIC_ID=
# Cron for cadence push. Vercel Hobby allows once per day only (see vercel.json).
# For every-10-minute reminders, upgrade to Pro or hit GET/POST /api/cron/reminders
# with Authorization: Bearer $CRON_SECRET from an external scheduler.
CRON_SECRET=
